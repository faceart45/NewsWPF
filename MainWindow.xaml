<Window x:Class="NewsWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="500" Width="450">

    <StackPanel VerticalAlignment="Center" Margin="30">
        <TextBlock Text="Логин" FontWeight="Bold"/>
        <TextBox x:Name="LoginTextBox" Margin="0,5,0,15" FontSize="16"/>

        <TextBlock Text="Пароль" FontWeight="Bold"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,5,0,25" FontSize="16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource BlueBtn}" Content="Войти" Click="Login_BtnClick" Margin="0,0,10,0"/>
            <Button Style="{StaticResource RedBtn}" Content="Выйти" Click="Exit_BtnClick"/>
        </StackPanel>
    </StackPanel>
</Window>